#!/usr/bin/env bash
# Mirror HTML reports and the files they reference (images, CSV, small JSON, ...)
# from runs/ and ml/runs/ into one folder that Globus can sync. Paths are kept,
# so relative report links keep working. Only files an HTML page links to (src=/href=,
# or a quoted relative asset path in its scripts) are copied; FITS, npz, checkpoints, Measurement Sets and CASA image
# tables (and the index.html browsers inside them) are never copied.
#
# usage: bin/sync-reports [--dry-run] [--delete] [--max-size MB] [--dest DIR] [RUN_DIR ...]
#   RUN_DIR     only scan these directories (under runs/ or ml/runs/); fast, use it in
#               chained jobs. Without RUN_DIR the whole runs/ and ml/runs/ trees are walked,
#               which takes ~30 min because of the large dataset runs.
#   --dest      default: $RADIOASTRO_SCRATCH/reports (from config/chpc.env if present)
#   --max-size  skip referenced files larger than this many MB (default 20)
#   --delete    remove mirrored files that are no longer selected
#   --dry-run   print the selected files and total size; copy nothing
set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
[[ -f "$ROOT/config/chpc.env" ]] && source "$ROOT/config/chpc.env"

dest=${RADIOASTRO_SCRATCH:+$RADIOASTRO_SCRATCH/reports}
max_mb=20
dry=0
delete=0
paths=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run) dry=1 ;;
        --delete) delete=1 ;;
        --max-size) max_mb=$2; shift ;;
        --dest) dest=$2; shift ;;
        -h|--help) sed -n '2,17p' "$0"; exit 0 ;;
        -*) echo "Unknown option: $1" >&2; exit 2 ;;
        *) [[ -d "$1" ]] || { echo "Not a directory: $1" >&2; exit 2; }
           paths+=("$(realpath "$1")") ;;
    esac
    shift
done
[[ -n "${dest:-}" ]] || { echo "Set --dest (RADIOASTRO_SCRATCH is not set)" >&2; exit 2; }
[[ $delete -eq 0 || ${#paths[@]} -eq 0 ]] || { echo "--delete needs a full sync (no RUN_DIR)" >&2; exit 2; }
command -v python3 >/dev/null || { echo "python3 is required" >&2; exit 1; }

select_files() {  # $1 = source root, $2.. = dirs to scan (default: root); prints paths relative to root
    python3 - "$1" "$max_mb" "${@:2}" <<'EOF'
import os, re, sys
from urllib.parse import unquote, urlsplit
root, limit = os.path.realpath(sys.argv[1]), float(sys.argv[2]) * 2**20
casa = (".ms", ".tt0", ".tt1", ".image", ".model", ".residual", ".psf", ".pb", ".sumwt", ".mask", ".weight", ".cl", ".G")
heavy = (".fits", ".fits.gz", ".fz", ".npz", ".npy", ".pt", ".pth", ".ckpt", ".h5", ".hdf5")
link = re.compile(r"""(?:src|href)\s*=\s*["']([^"'#?]+)""", re.I)
# Paths built in page scripts/JSON, e.g. "images/<source>/<id>_clean.png".
quoted = re.compile(r"""["']([^"'\s<>?#]+\.(?:png|jpe?g|svg|gif|webp|csv|json|txt))["']""", re.I)
selected = set()
for d, dirs, files in (w for start in (sys.argv[3:] or [root]) for w in os.walk(start)):
    dirs[:] = [x for x in dirs if not x.endswith(casa) and x != "scratch" and not x.startswith("TempLattice")]
    for name in files:
        if not name.lower().endswith((".html", ".htm")):
            continue
        page = os.path.join(d, name)
        selected.add(page)
        text = open(page, encoding="utf-8", errors="ignore").read()
        for ref in set(link.findall(text)) | set(quoted.findall(text)):
            if urlsplit(ref).scheme or ref.startswith(("/", "data:", "mailto:")):
                continue
            path = os.path.realpath(os.path.join(d, unquote(ref)))
            if (path.startswith(root + os.sep) and os.path.isfile(path) and not path.lower().endswith(heavy)
                    and not any(part.endswith(casa) for part in path[len(root):].split(os.sep))
                    and os.path.getsize(path) <= limit):
                selected.add(path)
for path in sorted(selected):
    print(os.path.relpath(path, root))
EOF
}

# Separate subfolders so run names in runs/ and ml/runs/ cannot collide.
for pair in "runs:runs" "ml/runs:ml-runs"; do
    src="$ROOT/${pair%%:*}"; target="$dest/${pair##*:}"
    [[ -d "$src" ]] || { echo "Skipping missing $src"; continue; }
    starts=()
    if [[ ${#paths[@]} -gt 0 ]]; then
        real=$(realpath "$src")
        for p in "${paths[@]}"; do [[ "$p" == "$real" || "$p" == "$real"/* ]] && starts+=("$p"); done
        [[ ${#starts[@]} -gt 0 ]] || continue
        matched=$(( ${matched:-0} + ${#starts[@]} ))
    fi
    list=$(mktemp)
    select_files "$src" "${starts[@]}" > "$list"
    total=$(cd "$src" && tr '\n' '\0' < "$list" | xargs -0 -r du -ck 2>/dev/null | tail -1 | cut -f1)
    total=${total:-0}  # empty selection: report 0 instead of sizing the whole tree
    echo "== $src/ -> $target/: $(wc -l < "$list" | tr -d ' ') files, $((total / 1024)) MB"
    if [[ $dry -eq 1 ]]; then
        cat "$list"
    else
        mkdir -p "$target"
        rsync -a --files-from="$list" "$src/" "$target/"
        if [[ $delete -eq 1 ]]; then
            (cd "$target" && find . -type f | sed 's|^\./||' | sort) | comm -23 - <(sort "$list") |
                while IFS= read -r stale; do rm -f "$target/$stale"; done
            find "$target" -type d -empty -delete
        fi
    fi
    rm -f "$list"
done
[[ ${#paths[@]} -eq 0 || ${matched:-0} -eq ${#paths[@]} ]] || { echo "Some RUN_DIRs are not under runs/ or ml/runs/" >&2; exit 2; }
