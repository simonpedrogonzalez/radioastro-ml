# Public template only. Run bin/configure-chpc on CHPC to create the ignored,
# fully resolved config/chpc.env. Do not source or use this template directly.

# Primary non-preemptible CPU allocation.
CHPC_CPU_PARTITION=__CHPC_CPU_PARTITION__
CHPC_CPU_QOS=__CHPC_CPU_QOS__
CHPC_CPU_ACCOUNT=__CHPC_CPU_ACCOUNT__

# Select a non-preemptible GPU allocation visible to your CHPC user. Leave QOS
# empty when that allocation does not require one.
CHPC_GPU_PARTITION=__CHPC_GPU_PARTITION__
CHPC_GPU_ACCOUNT=__CHPC_GPU_ACCOUNT__
CHPC_GPU_QOS=
CHPC_GPU_GRES=gpu:1

RADIOASTRO_SCRATCH=/scratch/general/vast/__CHPC_USERNAME__/radioastroml
UV_PROJECT_ENVIRONMENT=/scratch/general/vast/__CHPC_USERNAME__/radioastroml/envs/ml
UV_CACHE_DIR=/scratch/general/vast/__CHPC_USERNAME__/radioastroml/.uv-cache

UV_MODULE=uv
QUARTO_MODULE=quarto
CASA_STANDARD_MODULE=casa
CASA_PIPELINE_MODULE=casa-vla

# setup-chpc reports whether the CHPC pipeline module needs this flag. Set it to
# --pipeline only when that probe says it is required.
CASA_PIPELINE_FLAG=

# Optional executable overrides, principally for macOS.
# CASA_STANDARD_BIN=/Users/you/Applications/CASA.app/Contents/MacOS/casa
# CASA_PIPELINE_BIN=/Users/you/Applications/CASA\ 2.app/Contents/MacOS/casa

CHPC_LOGIN_HOST=__CHPC_LOGIN_HOST__
JUPYTER_PORT=8888

ML_CPU_CPUS=8
ML_CPU_MEM=64G
ML_CPU_TIME=12:00:00
ML_GPU_CPUS=4
ML_GPU_MEM=48G
ML_GPU_TIME=12:00:00
CASA_CPUS=8
CASA_MEM=64G
CASA_TIME=24:00:00
SESSION_CPUS=4
SESSION_MEM=32G
SESSION_TIME=04:00:00
